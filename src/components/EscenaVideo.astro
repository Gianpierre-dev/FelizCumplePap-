---
import { resolverPoster, rutaVideo } from "../data/assets";
import type { Familiar } from "../data/guion";

interface Props {
  video: string;
  poster: string;
  frase?: string;
  familiar?: Familiar;
}
const { video, poster, frase, familiar } = Astro.props;
const fuentePoster = resolverPoster(poster);
---
<section class="foto-escena flex flex-col items-center px-6 py-7">
  <div class="revelar flex w-full max-w-md flex-col items-center gap-4">
    <figure class="foto-impresa m-0 w-full bg-white p-3 pb-4">
      <video
        class="block h-auto w-full bg-black"
        src={rutaVideo(video)}
        poster={fuentePoster.src}
        controls
        playsinline
        preload="metadata"
      ></video>
      {familiar && (
        <figcaption class="pt-2 text-center font-manuscrita text-xl leading-none text-tinta-suave">
          con {familiar}
        </figcaption>
      )}
    </figure>
    {frase && (
      <p class="max-w-sm text-center font-manuscrita text-2xl leading-snug text-tinta">{frase}</p>
    )}
  </div>
</section>
