---
import { Image } from "astro:assets";
import { resolverImagen } from "../data/assets";
import type { Familiar } from "../data/guion";

interface Props {
  imagen: string;
  frase?: string;
  familiar?: Familiar;
}
const { imagen, frase, familiar } = Astro.props;
const fuente = resolverImagen(imagen);
const textoAlternativo = frase ?? (familiar ? `Recuerdo con ${familiar}` : "Recuerdo familiar");
---
<section class="foto-escena flex min-h-screen flex-col items-center justify-center gap-7 px-5 py-16">
  <div class="revelar flex flex-col items-center gap-7">
    <figure class="foto-impresa m-0 bg-white p-3 pb-4">
      <Image
        src={fuente}
        alt={textoAlternativo}
        class="block h-auto max-h-[64vh] w-auto max-w-full"
      />
      {familiar && (
        <figcaption class="pt-2 text-center font-manuscrita text-xl leading-none text-tinta-suave">
          con {familiar}
        </figcaption>
      )}
    </figure>
    {frase && (
      <p class="max-w-sm text-center font-manuscrita text-2xl leading-snug text-tinta">{frase}</p>
    )}
  </div>
</section>
