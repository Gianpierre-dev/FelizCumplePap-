---
// src/components/Portada.astro
---
<section
  data-portada
  class="fixed inset-0 z-50 flex flex-col items-center justify-center bg-crema px-6 text-center transition-opacity duration-700"
>
  <div class="pointer-events-none absolute inset-3 rounded-sm border border-granate/50" aria-hidden="true"></div>
  <div class="pointer-events-none absolute inset-[18px] rounded-sm border border-granate/25" aria-hidden="true"></div>

  <p class="mb-5 -rotate-3 rounded-sm border border-dashed border-granate/60 px-3.5 py-1 font-manuscrita text-xl text-granate">
    13 de junio
  </p>
  <h1 class="font-titulo text-4xl font-semibold italic leading-tight text-tinta">
    Feliz cumpleaños,<br />papá
  </h1>
  <p class="mt-3 font-manuscrita text-2xl text-tinta-suave">Toda tu familia, desde el Perú</p>
  <button
    data-comenzar
    type="button"
    class="mt-8 inline-flex items-center gap-2 rounded-full bg-granate px-7 py-3.5 text-sm font-semibold text-crema shadow-lg shadow-granate/30 transition hover:bg-granate-claro active:scale-95"
  >
    <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
      <path d="M8 5.14v13.72c0 .8.87 1.3 1.56.88l11.2-6.86a1.03 1.03 0 0 0 0-1.76L9.56 4.26A1.03 1.03 0 0 0 8 5.14Z" />
    </svg>
    Tocar para comenzar
  </button>
</section>

<style>
  :global([data-portada].oculto) {
    opacity: 0;
    pointer-events: none;
  }
</style>
