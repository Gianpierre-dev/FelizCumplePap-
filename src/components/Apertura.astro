---
interface Props { texto: string }
const { texto } = Astro.props;
---
<section class="flex min-h-screen items-center justify-center px-8">
  <div class="revelar flex flex-col items-center gap-7">
    <div class="ornamento" aria-hidden="true">✦</div>
    <p class="max-w-md text-center font-manuscrita text-3xl leading-relaxed text-tinta">{texto}</p>
  </div>
</section>
